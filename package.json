{
  "name": "@caffeine/template-app",
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "start:api": "node server.js",
    "dev:frontend": "pnpm --filter @caffeine/template-frontend dev",
    "build:frontend": "pnpm --filter @caffeine/template-frontend build"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
